<!-- Example -->
<group name="local,syslog,sshd,">

  <!--
  Dec 10 01:02:02 host sshd[1234]: Failed none for root from 1.1.1.1 port 1066 ssh2
  -->
  <rule id="100001" level="5">
    <if_sid>5716</if_sid>
    <srcip>1.1.1.1</srcip>
    <description>sshd: authentication failed from IP 1.1.1.1.</description>
    <group>authentication_failed,pci_dss_10.2.4,pci_dss_10.2.5,</group>
  </rule>

</group>
<group name="firewall-debian,nftables,">
  <rule id="100051" level="7">
    <match>CT-ERR_FROM-EXTERNAL_ICMP-REP_</match>
    <description>Failed ICMP connection tracking validationfrom external host</description>
  </rule>
</group>

<group name="firewall-debian,nftables,">
  <rule id="100052" level="7">
    <match>CT-ERR_FROM-EXTERNAL_HTTP-REP_</match>
    <description>Failed HTTP connection tracking validation from external host</description>
  </rule>
</group>

<group name="firewall-debian,nftables,">
  <rule id="100053" level="7">
    <match>CT-ERR_FROM-DMZ-TO-ADMIN_HTTP-REP_</match>
